{
  // 테스트 타입 검사 — **이전에도 검사는 되고 있었다. 다만 아무도 그걸 요구하지 않았다.**
  // tsconfig.scripts.json이 `include: ["scripts", "src"]`라 src 전체가 그 프로젝트에
  // 딸려 들어갔고, 테스트 커버리지는 그 부수효과였다. 그 `src`는 scripts가 src를
  // import하니까 들어간 것이라, include를 `["scripts"]`로 좁히는 정리 커밋 하나면
  // **테스트 110개가 통째로 무음 이탈하면서 `tsc -b`는 초록**이다(실측: rc=0, 오류 0건).
  // 이 파일은 그 커버리지를 의도로 못 박고, verify-typecheck-coverage가 잠근다.
  //
  // **app과 분리하는 이유는 node 타입이다.** 이 리포의 계약 테스트는 디스크를 읽어
  // 산출물·매니페스트·CSS를 검사하므로 `fs`·`process`·`import.meta.dirname`이 필요하다.
  // 그렇다고 tsconfig.app.json에 `"node"`를 넣으면 **브라우저에서 도는 앱 소스에도**
  // node 전역이 열려 `process.env`를 쓰고도 tsc가 통과한다. scripts를 따로 검사하는
  // tsconfig.scripts.json과 같은 구조로 테스트만 떼어 낸다.
  //
  // src는 테스트가 import하므로 함께 들어온다. app·scripts와 같은 파일을 다시 컴파일하는
  // 값은 실측으로 `tsc -b` cold 5.6초 → 7.9초(+41%, 3회 평균)와 진단 중복 출력이다 — 오탐·미탐은
  // 없고(설정이 같은 방향), **앱 소스의 node 전역 금지는 app 쪽 검사가 그대로 유지한다**
  // (여기서 통과해도 app에서 걸려 tsc -b가 실패한다).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    // jest-dom 매처(toBeVisible/toBeDisabled 등)는 src/test/setup.ts의
    // `@testing-library/jest-dom/vitest` import가 전역 확장으로 등록한다.
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/__tests__/**/*", "src/test"]
}
