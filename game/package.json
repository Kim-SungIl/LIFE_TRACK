{
  "name": "game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-cg-manifest.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-cg-manifest.mjs",
    "build": "tsc -b && vite build",
    "build:release": "GEN_WEBP=1 npm run build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "rm -f node_modules/.tmp/vitest-report.json && vitest run --reporter=default --reporter=json --outputFile.json=node_modules/.tmp/vitest-report.json",
    "check": "tsc -b && vite build",
    "verify:events": "tsx scripts/verify/verify-events-split.ts",
    "verify:save-load": "tsx scripts/verify/verify-save-load.ts",
    "verify:bg-level": "tsx scripts/verify/verify-background-school-level.ts",
    "verify:ci-gates": "tsx scripts/verify/verify-ci-gates.ts",
    "verify:content": "npm run verify:ci",
    "verify:ci": "tsx scripts/verify/run-chain.ts",
    "verify:dist-fonts": "tsx scripts/verify/verify-dist-fonts.ts",
    "verify:dist-hygiene": "tsx scripts/verify/verify-dist-hygiene.ts",
    "verify:dist-chunks": "tsx scripts/verify/verify-dist-chunks.ts",
    "verify:dist-typography": "tsx scripts/verify/verify-dist-typography.ts",
    "verify:dist-cg-thumbs": "tsx scripts/verify/verify-dist-cg-thumbs.ts",
    "verify:test-floor": "tsx scripts/verify/verify-test-floor.ts"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  }
}
