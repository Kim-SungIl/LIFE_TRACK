    "jihun-hs-unsaid": {
      "id": "jihun-hs-unsaid",
      "reach": {
        "npc": "jihun",
        "tier": 93,
        "year": 6
      },
      "title": "말 못한 한마디",
      "description": "야자 빠진 저녁, 둘만 남은 교실. 노을이 책상 줄을 길게 가른다. 지훈이 한참 말이 없다가, 입을 열려다 만다.\n\"…아니다.\" 평소의 활기가 없다. \"야, 나 사실 너한테 할 말이 있는데.\" 그러고는 또 멈춘다. 무언가가 목에 걸린 얼굴이다.",
      "femaleDescription": "야자 빠진 저녁, 둘만 남은 교실. 노을이 책상 줄을 길게 가른다. 지훈이 한참 말이 없다가, 입을 열려다 만다.\n\"…아니다.\" 평소의 활기가 없다. \"야, 나 사실 너한테…\" 그러고는 또 멈춘다. 귀가 조금 붉다. 무언가가 목에 걸린 얼굴이다.",
      "speakers": [
        "jihun"
      ],
      "location": "classroom",
      "background": "classroom_high_afternoon",
      "choices": [
        {
          "text": "\"천천히 말해. 나 안 가고 기다릴게\" 끝까지 듣는다",
          "effects": {
            "mental": 2,
            "social": 1
          },
          "npcEffects": [
            {
              "npcId": "jihun",
              "intimacyChange": 5
            }
          ],
          "message": "지훈이 숨을 한 번 고른다. \"…야, 너 없었으면 고등학교 어떻게 버텼냐. 그 말, 한 번은 해야 될 것 같아서.\" 노을이 둘 사이로 진다.",
          "timeCost": 1,
          "memorySlotDraft": {
            "category": "growth",
            "importance": 7,
            "toneTag": "breakthrough",
            "recallText": "둘만 남은 교실, 지훈이 끝내 꺼낸 한마디.",
            "npcIds": [
              "jihun"
            ]
          }
        },
        {
          "text": "\"말하기 힘들면 안 해도 돼\" 퇴로를 연다",
          "effects": {
            "mental": 1,
            "social": 1
          },
          "npcEffects": [
            {
              "npcId": "jihun",
              "intimacyChange": 4
            }
          ],
          "message": "\"…그래. 다음에 하지 뭐.\" 지훈이 그 말을 도로 삼킨다. 무언가가 노을 속으로 그냥 묻힌다.",
          "timeCost": 1,
          "memorySlotDraft": {
            "category": "failure",
            "importance": 7,
            "toneTag": "regret",
            "recallText": "둘만 남은 교실, 지훈이 끝내 못 꺼낸 한마디.",
            "npcIds": [
              "jihun"
            ]
          }
        },
        {
          "text": "\"긴장한 너 처음 본다\" 분위기를 푼다",
          "effects": {
            "social": 1
          },
          "npcEffects": [
            {
              "npcId": "jihun",
              "intimacyChange": 3
            }
          ],
          "message": "\"긴장은 무슨!\" 발끈하는 사이 타이밍이 지나간다. 지훈이 그 말을 도로 삼킨다.",
          "timeCost": 1,
          "memorySlotDraft": {
            "category": "failure",
            "importance": 7,
            "toneTag": "regret",
            "recallText": "둘만 남은 교실, 지훈이 끝내 못 꺼낸 한마디.",
            "npcIds": [
              "jihun"
            ]
          }
        }
      ],
      "femaleChoices": [
        {
          "text": "\"천천히 말해. 나 안 가고 기다릴게\" 끝까지 듣는다",
